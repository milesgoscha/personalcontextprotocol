# PCP Hosted Service Configuration
# Copy this file to .env and fill in the values

# ===================
# Required Settings
# ===================

# Domain for the hosted service (e.g., pcp.example.com)
# User nodes will be at {username}.pcp.example.com
PCP_DOMAIN=pcp.example.com

# PostgreSQL password
POSTGRES_PASSWORD=your-secure-password-here

# JWT secret for authentication (generate with: openssl rand -hex 32)
JWT_SECRET=your-jwt-secret-here

# Master encryption key for admin tokens (generate with: openssl rand -hex 32)
MASTER_ENCRYPTION_KEY=your-encryption-key-here

# Email for Let's Encrypt certificates
ACME_EMAIL=admin@example.com

# ===================
# DNS Provider (for wildcard certs)
# ===================

# DNS provider for Let's Encrypt DNS challenge
# Options: cloudflare, route53, digitalocean, etc.
DNS_PROVIDER=cloudflare

# Cloudflare credentials (if using Cloudflare)
CF_API_EMAIL=
CF_DNS_API_TOKEN=

# AWS credentials (if using Route53)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_HOSTED_ZONE_ID=

# ===================
# Optional Settings
# ===================

# PostgreSQL settings
POSTGRES_USER=pcp
POSTGRES_DB=pcp_hosted

# PCP node Docker image
PCP_IMAGE=pcp:latest

# Debug mode (set to true for development)
DEBUG=false

# Key versioning for rotation (format: v1:key1,v2:key2)
# Leave empty to use MASTER_ENCRYPTION_KEY as v1
ENCRYPTION_KEYS=

# Admin users (comma-separated usernames)
# These users can access admin-only features like grants management
ADMIN_USERNAMES=

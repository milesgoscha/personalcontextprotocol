# PCP Hosted Service - LOCAL DEVELOPMENT
# Copy to .env: cp .env.dev.example .env

# Domain - uses .localhost for automatic wildcard resolution
PCP_DOMAIN=pcp.localhost

# PostgreSQL (dev defaults)
POSTGRES_USER=pcp
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=pcp_hosted

# Auth secrets (dev values - NEVER use in production)
JWT_SECRET=dev-jwt-secret-change-in-production-please
MASTER_ENCRYPTION_KEY=dev-encryption-key-32-bytes-ok

# PCP node Docker image
PCP_IMAGE=pcp:latest

# Debug mode
DEBUG=true

# Admin users (comma-separated usernames)
# Set to your username to access admin features like grants management
ADMIN_USERNAMES=
